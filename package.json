{
  "name": "luigigargioni.github.io",
  "version": "1.0.0",
  "homepage": "https://luigigargioni.github.io",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint . --ext .ts,.tsx",
    "lintfix": "eslint . --ext .ts,.tsx --fix",
    "pretty": "prettier --write **/*.{ts,tsx}",
    "build-maps": "set \"GENERATE_SOURCEMAP=true\" && npm run build",
    "analyze": "npm run build-maps && source-map-explorer 'build/static/js/*.js'",
    "predeploy": "npm run build",
    "deploy": "rm -rf node_modules/.cache/gh-pages & gh-pages -b gh-pages -d build"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "^5.10.14",
    "react": "^18.2.0",
    "react-awesome-reveal": "^4.1.0",
    "react-dom": "^18.2.0",
    "react-fast-marquee": "^1.3.5",
    "react-icons": "^4.6.0",
    "react-router-dom": "^6.4.3",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "^5.0.1",
    "typescript": "^4.9.3"
  },
  "devDependencies": {
    "@types/react-dom": "^18.0.9",
    "@types/react-router-hash-link": "^2.4.5",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "eslint": "^8.27.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "gh-pages": "^4.0.0",
    "prettier": "^2.7.1",
    "source-map-explorer": "^2.5.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
