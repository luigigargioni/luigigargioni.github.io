{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["build/**", "coverage/**"],
  "rules": {
    "no-console": "warn",
    "no-shadow": "error",
    "typescript/no-explicit-any": "off"
  }
}
